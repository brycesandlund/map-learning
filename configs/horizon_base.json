{
  "collect_steps": 10000,
  "warmup_steps": 1000,
  "train_every": 10,
  "updates_per_train": 5,
  "cadence_diagnostics": true,
  "maze": {
    "size": 12,
    "seed": 7,
    "step_size": 0.25,
    "episode_steps": 2000
  },
  "model": {
    "latent_dim": 8,
    "hidden_dim": 256,
    "hidden_layers": 3,
    "ensemble_size": 3,
    "mixture_components": 1,
    "latent_activation": "identity"
  },
  "train": {
    "loss": "probabilistic",
    "prediction_objective": "mse",
    "encoder_lr_multiplier": 0.3,
    "batch_size": 128,
    "lr": 0.0003,
    "repulsion_weight": 0.01,
    "log_every": 1000
  },
  "planner": {
    "behavior": "disagreement",
    "search": "mcts",
    "horizon": 4,
    "simulations": 24,
    "uncertainty_discount": 0.99,
    "epsilon_random": 0.1,
    "uct_exploration": 0.3
  },
  "training_schedule": "epoch",
  "checkpoint_every": 2000,
  "reward_snapshot_every": 200
}
